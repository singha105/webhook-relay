# Copy to .env and edit if you need to override a default.
# `make up` works with no .env at all — every value here is the default.

# --- API ---
HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s

# --- Postgres ---
# The compose stack creates this user, password, and database.
DATABASE_URL=postgres://webhook_relay:webhook_relay@postgres:5432/webhook_relay?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=10s

# --- Valkey ---
# Unused on day 1; validated at boot so a bad value fails fast rather than
# surfacing on day 2.
VALKEY_URL=redis://valkey:6379

# --- Host port mappings ---
# Only affect the host side of the compose port mappings. Override any that
# collide with something already running on your machine; `make up` refuses to
# start and tells you which one to change.
API_PORT=8080
POSTGRES_PORT=5432
VALKEY_PORT=6379

# --- Delivery (day 2) ---
WORKER_CONCURRENCY=10
MAX_ATTEMPTS=6
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=1h
DELIVERY_TIMEOUT=10s
STALE_CLAIM_TIMEOUT=60s
DELIVERY_LEASE=5m

# Delivery-side duplicate suppression. Defaults on. Day 5 sets this to false
# on purpose to demonstrate the duplicate deliveries it prevents.
DELIVERY_DEDUP_ENABLED=true

# Host port for the demo sink (started with: make demo-up).
SINK_PORT=9090

# --- Resilience (day 3) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST_FACTOR=1.0
BREAKER_ENABLED=true
BREAKER_THRESHOLD=10
BREAKER_COOLDOWN=5m

# --- Observability (day 3) ---
TRACING_ENABLED=true
OTLP_ENDPOINT=otel-collector:4317
TRACE_SAMPLE_RATIO=1.0
METRICS_ADDR=:9100
SERVICE_VERSION=dev

# --- Lifecycle (day 3) ---
DRAIN_TIMEOUT=30s
# Fails API readiness when the oldest undelivered event is older than this,
# shedding ingest while the workers catch up. Zero disables the check.
READINESS_MAX_BACKLOG_AGE=2m

# --- Host ports for the observability stack ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9190
OTLP_GRPC_PORT=4317
WORKER_METRICS_PORT=9100
