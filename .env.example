# Copy to .env and edit if you need to override a default.
# `make up` works with no .env at all — every value here is the default.

# --- API ---
HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s

# --- Postgres ---
# The compose stack creates this user, password, and database.
DATABASE_URL=postgres://webhook_relay:webhook_relay@postgres:5432/webhook_relay?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=10s

# --- Valkey ---
# Unused on day 1; validated at boot so a bad value fails fast rather than
# surfacing on day 2.
VALKEY_URL=redis://valkey:6379

# --- Host port mappings ---
# Only affect the host side of the compose port mappings. Override any that
# collide with something already running on your machine; `make up` refuses to
# start and tells you which one to change.
API_PORT=8080
POSTGRES_PORT=5432
VALKEY_PORT=6379
