# The test sink, containerized so the compose demo can reach it from the worker
# by service name. Same multi-stage, distroless approach as the service itself;
# it is a fixture, but a fixture that is awkward to run is a fixture nobody runs.
FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sink ./test/sink/cmd/sink

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/sink /sink
USER nonroot:nonroot
EXPOSE 9090
ENTRYPOINT ["/sink", "-addr", ":9090"]
