      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (event_type) (rate(webhook_events_ingested_total[1m]))",
          "legendFormat": "{{event_type}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
