      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(webhook_events_dlq_total[1h])) or vector(0)",
          "legendFormat": "dlq",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 101,
