# Binaries.
# These MUST stay anchored with a leading slash. An unanchored "api" matches
# any path segment at any depth, which silently excluded cmd/api and
# cmd/worker from the repository — the code built locally and the image failed
# to build in CI.
/bin/
/dist/
/webhook-relay
/api
/worker
*.exe

# Test & coverage
*.out
coverage.html
/testdata/tmp/

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
id_rsa*
*_rsa
credentials.json
secrets.yaml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log

# Kubernetes / Helm
kubeconfig
*.kubeconfig
charts/**/charts/
charts/**/Chart.lock

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Go workspace
go.work
go.work.sum

# Local data volumes
/deploy/compose/data/

# Terraform
# *.tfstate is already ignored above; these are the rest of the local-state
# footprint. The lock file IS intentionally excluded here because this project
# pins every provider version explicitly in versions.tf and the lock would
# otherwise pin to one platform's hashes, breaking a Linux CI runner that
# initialises after a macOS developer committed it. A team with a homogeneous
# CI platform should commit it.
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/crash.log
terraform/override.tf
terraform/override.tf.json

# SOPS age private key — the one file that must never be committed.
age.key
*.agekey
