# Binaries.
# These MUST stay anchored with a leading slash. An unanchored "api" matches
# any path segment at any depth, which silently excluded cmd/api and
# cmd/worker from the repository — the code built locally and the image failed
# to build in CI.
/bin/
/dist/
/webhook-relay
/api
/worker
*.exe

# Test & coverage
*.out
coverage.html
/testdata/tmp/

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
id_rsa*
*_rsa
credentials.json
secrets.yaml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log

# Kubernetes / Helm
kubeconfig
*.kubeconfig
charts/**/charts/
charts/**/Chart.lock

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Go workspace
go.work
go.work.sum

# Local data volumes
/deploy/compose/data/
